# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# Database
*.db
*.sqlite3

# Generated PDFs and documents
generated/
*.pdf

# Design mockups — heavy artifacts (PDFs, bundle exports). Kept locally only;
# regenerate via Claude Design when needed. README is committed so the dir is
# discoverable; everything else inside is gitignored.
docs/design/mockups/*
!docs/design/mockups/README.md
!docs/design/mockups/.gitkeep

# Personal scratchpad — agent must not implement from this file
TODO.md

# Dev state (Postgres data, snapshots, logs) — mirrors production ~/.naavik
.naavik/

# Typst build artifacts
*.typst.pdf

# IDE / agent state
.idea/
.vscode/
*.local.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Ruff
.ruff_cache/

# Alembic
migrations/versions/__pycache__/

# Misc
*.log
.direnv/

# Nix
result
result-*

# Claude Code per-fork worktrees — local-only scratch dirs created by /worktree skill
.claude/worktrees/

# Visual QA — local capture output (baseline/ is committed; screenshots/ is ad-hoc)
tests/visual/screenshots/

# Agent trace logs — per-run directories under traces/; keep .gitkeep so the dir is discoverable
traces/*
!traces/.gitkeep

# Agent system per-fork caches — every fork runs `scripts/gh-project.sh init` + `refresh-map` once
.claude/github-project.json
.claude/github-issue-map.json
.claude/budget-ledger.json

# Agent memory stores — gitignored per-fork (A.15), EXCEPT:
#   - .keep (tracks the dir)
#   - knowledge/*.md (seeded + promoted entries ship in git as shared cross-contributor reference)
# Writes go through scripts/agent-memory.sh (single writer rule).
.claude/memory/*
!.claude/memory/.keep
!.claude/memory/knowledge/
.claude/memory/knowledge/*
!.claude/memory/knowledge/*.md
