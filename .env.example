# .env.example — Naavik environment configuration
#
# Copy to .env (gitignored) and fill in values. Each row is OPTIONAL unless
# marked REQUIRED. Defaults in `src/config.py` are designed for local dev
# orchestrator; production stacks (docker compose / NixOS module) override.
#
# Security: chmod 0600 .env after editing. The `.env` file replaces the
# encrypted vault deprecated in 0.2.0 — filesystem permissions are the
# operative defense.

# ── Database (REQUIRED for docker compose / NixOS; orchestrator overrides) ──
# DATABASE_URL=postgresql+asyncpg://naavik:password@localhost:5432/naavik

# ── Security (REQUIRED for any deployment outside `nix run .#dev`) ──
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be ≥ 32 bytes. Used for JWT signing; rotating invalidates active
# sessions. NAAVIK_DEBUG=1 bypasses the 32-byte check for local dev only.
# SECRET_KEY=

# ── LLM Providers (at least one for AI features) ──
# Plan 26 (0.2.0.01): these were stored in `~/.naavik/secrets.enc` before
# 0.2.0; now exclusively env. Settings UI shows configured-via-env ✓/✗
# without surfacing values.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── Optional Integrations ──
# DISCORD_WEBHOOK_URL=             # New high-score job alerts, app-submitted, etc.
# TELEGRAM_BOT_TOKEN=              # Outbound notifications; chat ID below
# TELEGRAM_CHAT_ID=                # Plan 26: was vault scope "notifications.telegram_chat_id"; now first-class env
# PORTFOLIO_WEBHOOK_URL=           # Netlify build trigger after Profile edits

# ── Data dir (state root: PDFs, snapshots, logs, dev-credentials) ──
# Default `.naavik` (dev orchestrator) or `~/.naavik` (NixOS) or `/app/.naavik` (docker).
# DATA_DIR=.naavik

# ── Server ──
# HOST=0.0.0.0
# PORT=8000

# ── Dev / debug (optional) ──
# NAAVIK_DEBUG=1                   # plan 10c: writes `~/.naavik/dev-credentials` + lifespan echo
# NAAVIK_DEV_PASSWORD=             # plan 10b: stable dev login across reseeds; leave unset to auto-generate
# NAAVIK_PERSISTENCE=db            # plan 10c: dev orchestrator forces; manual override for nix-develop interactive use

# ── Scraper config (plan 33 / 0.2.0.07) ──
# Comma-separated company slugs for the per-board ATS / Workday scrapers.
# Cron skips a source silently when its company list is unset; defaults are
# conservative + opt-in. Leave blank for no scraping of that source.
# GREENHOUSE_COMPANIES=anthropic,scale,databricks
# LEVER_COMPANIES=netflix,figma
# ASHBY_COMPANIES=ramp,vercel
# WORKDAY_COMPANIES=salesforce/External,adobe/Adobe_Careers   # format: <tenant>[/<site>]
# SCRAPER_RSSHUB_URL=              # optional LinkedIn RSShub fallback base URL
