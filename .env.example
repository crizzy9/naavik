# Required
DATABASE_URL=postgresql+asyncpg://naavik:password@localhost:5432/naavik
SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM Providers (at least one required for AI features)
ANTHROPIC_API_KEY=                    # Claude API key
OPENAI_API_KEY=                       # OpenAI API key
OLLAMA_BASE_URL=http://localhost:11434 # Local Ollama instance

# Optional Integrations
DISCORD_WEBHOOK_URL=                  # Discord webhook for job notifications
TELEGRAM_BOT_TOKEN=                   # Telegram bot for notifications
PORTFOLIO_WEBHOOK_URL=                # Netlify/Vercel rebuild trigger

# OAuth (optional - for multi-user auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server
HOST=0.0.0.0
PORT=8000
