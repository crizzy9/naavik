# All values here are OPTIONAL. config.py provides working defaults.
# Override only what differs from defaults.

# Database
# DATABASE_URL=postgresql+asyncpg://naavik:password@localhost:5432/naavik

# Security (override in production!)
# SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM Providers (at least one needed for AI features)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional Integrations
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# PORTFOLIO_WEBHOOK_URL=

# Data dir (state root: PDFs, secrets.enc, snapshots, logs)
# DATA_DIR=.naavik

# Server
# HOST=0.0.0.0
# PORT=8000
